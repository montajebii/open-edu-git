# Copy to .env and adjust. `.env` is git-ignored.

# --- Required ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=openedu
POSTGRES_PASSWORD=openedu_password
POSTGRES_DB=openedu_db

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Backend ----------------------------------------------------------------
# Browser-facing API URL. Inlined at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# When true, register leaves the account unverified until the emailed
# /auth/verify-email link is opened. Requires SMTP (or leave SMTP unset to
# have the link logged by the backend instead).
REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_TOKEN_EXPIRE_HOURS=24
MAX_UPLOAD_MB=25

# --- Email (required only when REQUIRE_EMAIL_VERIFICATION=true) --------------
# Origin used to build verification links.
FRONTEND_URL=http://localhost:3000
# Leave as smtp.example.com to disable sending: the verification link is then
# written to the backend log so local setups can still verify.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_TIMEOUT=10
EMAIL_FROM=noreply@openedugit.ir

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
