# Copy to .env and adjust. `.env` is git-ignored.

# --- Required ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=openedu
POSTGRES_PASSWORD=openedu_password
POSTGRES_DB=openedu_db

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Backend ----------------------------------------------------------------
# Browser-facing API URL. Inlined at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Keep false until /auth/verify-email is implemented.
REQUIRE_EMAIL_VERIFICATION=false
MAX_UPLOAD_MB=25

# --- Email (optional until verification is implemented) ---------------------
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@openedugit.ir

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
